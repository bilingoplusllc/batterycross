# Сборка. Восстанавливается прогоном `python render.py`, и CI собирает её
# заново на каждой выкладке: хранить её здесь значит завести вторую копию,
# которая однажды разойдётся с генератором.
dist/

# Чужие даташиты — 60 МБ PDF производителя. Сборке они не нужны (величины
# уже разобраны в data/), а публиковать чужие файлы мы не будем.
.cache/

# Служебное
__pycache__/
*.pyc
.claude/
